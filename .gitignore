.DS_Store
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Ride logs are large and are DATA, not source. Keep one small trimmed
# fixture in Fixtures/ for tests; everything else stays out of git.
Rides/
*.ndjson
!Fixtures/*.ndjson
*.mov
*.mp4

# Xcode per-user state
*.xcuserstate
xcuserdata/

# Beta diagnostic-upload config. Holds the live API endpoint and the X-Beta-Key
# abuse-gate token, so it must never enter git history. The committed
# BetaUpload.xcconfig.example is the template; copy it and fill in the values from
# the loftmeter-beta-diag stack outputs. Attached as the app target's Debug base
# configuration, so a missing file just means beta upload no-ops.
BetaUpload.xcconfig
!BetaUpload.xcconfig.example
