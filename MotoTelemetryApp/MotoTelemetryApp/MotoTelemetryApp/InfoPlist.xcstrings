    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Location (background) permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records your speed and distance from GPS while a run is active, including when the app is in the background during a ride."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre vitesse et votre distance par GPS pendant une session, y compris lorsque l'application est en arrière-plan durant un trajet."
          }
        }
      }
    },
