  "sourceLanguage" : "en",
  "strings" : {
    "Hold the bike upright and still,\nengine off" : {
      "extractionState" : "manual",
      "comment" : "Calibration screen title while measuring",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la moto droite et immobile,\nmoteur coupé"
          }
        }
      }
    },
    "Calibrated" : {
      "extractionState" : "manual",
      "comment" : "Calibration screen title when done",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibré"
          }
        }
      }
    },
    "Couldn't calibrate:\n%@" : {
      "extractionState" : "manual",
