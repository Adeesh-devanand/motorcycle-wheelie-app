# Fastfile — release automation for Loftmeter (MotoTelemetryApp).
#
# The `beta` lane builds a signed Release archive with the current Xcode/SDK and uploads
# it to TestFlight. It is designed to run on a GitHub macOS runner with Xcode 26+ (the
# App Store SDK floor), which this project's local Intel Mac cannot provide.
#
# SIGNING: no fastlane match, no local Ruby needed on the developer's Mac. This lane
# uses the App Store Connect API KEY to let Apple/Xcode fetch-or-create the distribution
# certificate and App Store provisioning profile at build time (`cert` + `sigh`), then
# archives with manual signing using the profile that was just synced. The only secrets
# required are the three API-key values — nothing to seed locally, nothing in a private
# signing repo.
#
# The API key is scoped and revocable; it is never an Apple ID/password. All secrets are
# injected by CI as environment variables. See docs/reviews/release-setup.md.

default_platform(:ios)

XCODEPROJ  = "MotoTelemetryApp/MotoTelemetryApp/MotoTelemetryApp.xcodeproj"
SCHEME     = "MotoTelemetryApp"
APP_ID     = "com.adeesh.MotoTelemetryApp"
TEAM_ID    = "9KZ4CCANYU"

platform :ios do
  # Build an App Store Connect API token from the three key secrets.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      # The .p8 is passed base64-encoded so the multi-line key survives one env var.
      key_content: ENV.fetch("ASC_KEY_CONTENT_B64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build a signed Release archive and upload it to TestFlight (Xcode automatic signing via API key, no match)"
  lane :beta do
    api_key = asc_api_key

    # Set a unique, monotonic build number from the current UTC time. We deliberately do
    # NOT query latest_testflight_build_number: that call requires the App Store Connect
    # app record to already exist and hard-fails ("Could not find an app ...") on a first
    # run, and a timestamp is monotonic across runs anyway so it can never collide.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M")
    )

    # Archive + export with XCODE AUTOMATIC signing. `-allowProvisioningUpdates` lets
    # xcodebuild create-or-download the distribution certificate AND the App Store
    # provisioning profile itself, authenticating with the App Store Connect API key —
    # and it installs the identity into the keychain as part of the same step.
    #
    # This replaced a `cert` + `sigh` pre-fetch, which failed on CI with "Could not find
    # the newly generated certificate installed": `cert` can register a certificate at
    # Apple but cannot reconstruct its PRIVATE KEY into a fresh CI keychain, so there was
    # no usable signing identity. Automatic signing sidesteps that — it never needs a
    # pre-seeded private key. (This is the one job match would otherwise own; we trade a
    # little reproducibility for zero local setup.)
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV["FL_OUTPUT_DIR"] || "build",
      output_name: "Loftmeter.ipa",
      xcargs: "-allowProvisioningUpdates",
      # The API key is passed so xcodebuild can authenticate to Apple during automatic
      # provisioning (fastlane writes it to the AuthKey path xcodebuild expects).
      api_key: api_key,
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID
      }
    )

    # Upload to TestFlight. Internal testers get it immediately; promote to external /
    # App Store from App Store Connect.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end
end
