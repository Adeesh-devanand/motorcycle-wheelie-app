# Fastfile — release automation for Loftmeter (MotoTelemetryApp).
#
# The `beta` lane builds a signed Release archive with the current Xcode/SDK and uploads
# it to TestFlight. It is designed to run on a GitHub macOS runner with Xcode 26+ (the
# App Store SDK floor), which this project's local Intel Mac cannot provide.
#
# Xcode handles automatic signing using an App Store Connect API key file on the
# ephemeral runner. Both archive and export receive Xcode's authentication flags.
# fastlane's upload action accepts the API-key hash directly; build_app does not.
# The three existing API-key secrets remain the only inputs.

require "base64"
require "shellwords"
require "tempfile"

default_platform(:ios)

XCODEPROJ  = "MotoTelemetryApp/MotoTelemetryApp/MotoTelemetryApp.xcodeproj"
SCHEME     = "MotoTelemetryApp"
APP_ID     = "com.adeesh.MotoTelemetryApp"
TEAM_ID    = "9KZ4CCANYU"

platform :ios do
  # Build an App Store Connect API token from the three key secrets.
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      # The .p8 is passed base64-encoded so the multi-line key survives one env var.
      key_content: ENV.fetch("ASC_KEY_CONTENT_B64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build a signed Release archive and upload it to TestFlight (Xcode automatic signing via API key, no match)"
  lane :beta do
    api_key = asc_api_key

    # Set a unique, monotonic build number from the current UTC time. We deliberately do
    # NOT query latest_testflight_build_number: that call requires the App Store Connect
    # app record to already exist and hard-fails ("Could not find an app ...") on a first
    # run, and a timestamp is monotonic across runs anyway so it can never collide.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M")
    )

    # build_app/gym has no api_key option. Materialize the key in a private temporary
    # file, then give BOTH xcodebuild phases the supported authentication arguments.
    # Tempfile.create removes the key even if archive or export raises an exception.
    Tempfile.create(["loftmeter-asc-", ".p8"]) do |key_file|
      key_file.chmod(0o600)
      key_file.write(Base64.strict_decode64(ENV.fetch("ASC_KEY_CONTENT_B64").gsub(/\s+/, "")))
      key_file.flush

      signing_args = Shellwords.join([
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_file.path,
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
      ])

      build_app(
        project: XCODEPROJ,
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        output_directory: ENV["FL_OUTPUT_DIR"] || "build",
        output_name: "Loftmeter.ipa",
        # gym 2.239.0 also forwards xcargs to exportArchive. Setting export_xcargs
        # to the same flags duplicates authenticationKeyPath and makes export fail.
        xcargs: signing_args,
        export_options: {
          signingStyle: "automatic",
          teamID: TEAM_ID
        }
      )
    end

    # Upload to TestFlight. Internal testers get it immediately; promote to external /
    # App Store from App Store Connect.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end
end
